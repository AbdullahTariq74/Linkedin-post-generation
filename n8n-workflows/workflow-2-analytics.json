      "parameters": {
        "jsCode": "// Get posts from last 7 days that have LinkedIn URLs\nconst rows = $input.all();\nconst sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst recentPosts = rows.filter(row => {\n  const postDate = new Date(row.json['Date']);\n  const hasUrl = row.json['LinkedIn Post URL'] && \n                 String(row.json['LinkedIn Post URL']).includes('linkedin.com');\n  return postDate >= sevenDaysAgo && hasUrl;\n});\n\nconsole.log(`Found ${recentPosts.length} LinkedIn posts from last 7 days`);\n\nif (recentPosts.length === 0) {\n  return [{ json: { noPosts: true, message: 'No LinkedIn posts found from last 7 days' } }];\n}\n\nreturn recentPosts.map(row => ({\n  json: {\n    date: row.json['Date'],\n    postTitle: row.json['Post Title'],\n    category: row.json['Topic Category'],\n    linkedInUrl: row.json['LinkedIn Post URL'],\n    linkedInStatus: row.json['LinkedIn Status']\n  }\n}));"
      },
