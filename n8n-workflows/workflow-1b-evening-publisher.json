    {
      "parameters": {
        "jsCode": "// Find today's post with Status='ready'\nconst today = new Date().toISOString().split('T')[0];\nconst rows = $input.all();\n\nconst readyPost = rows.find(r => {\n  const rowDate = String(r.json['Date'] || '').trim();\n  const status = String(r.json['Status'] || '').trim().toLowerCase();\n  return rowDate === today && status === 'ready';\n});\n\nif (!readyPost) {\n  console.log(`No post with Status='ready' found for ${today}. Nothing to send.`);\n  return [{ json: { skip: true, reason: `No approved post for ${today}`, date: today } }];\n}\n\nconsole.log(`Ready post found: \"${readyPost.json['Post Title']}\"`);\nreturn [{ json: {\n  skip: false,\n  date: readyPost.json['Date'],\n  dayName: readyPost.json['Day'] || '',\n  title: readyPost.json['Post Title'],\n  linkedInPost: readyPost.json['Post Content (Full)'],\n  contraPost: readyPost.json['Contra Post Content'] || readyPost.json['Post Content (Full)'],\n  imageUrl: readyPost.json['Image URL'] || '',\n  category: readyPost.json['Topic Category'] || ''\n}}];"
      },
